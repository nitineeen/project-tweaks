# ============================================================
# Tweaks env — copy to .env.local and fill in. Works NOW with
# Section 1 alone (local SQLite + mock AI + dev token, no accounts).
# Paste a Meta key in Section 4 for live AI, or leave it blank for mock mode.
# ============================================================

# ---------- 0) Mode switches ----------
AI_PROVIDER=mock          # mock (now: deterministic fixtures, no network) | real (later)
DB_PROVIDER=sqlite        # local SQLite file below, created automatically
AUTH_MODE=dev-token       # single local space, extension-token auth

# ---------- 1) Local dev — works NOW, nothing to sign up for ----------
# SQLite file is created automatically on first run. Real SQL tables
# (saves, user_memory, taxonomy_stats, threads, usage).
SQLITE_PATH=./.local/tweaks.db
# Token you paste into the extension popup Settings → Token. Any long string.
DEV_EXTENSION_TOKEN=dev-local-token-CHANGE-ME
NEXT_PUBLIC_WEB_URL=http://localhost:3121
CRON_SECRET=local-cron-secret-CHANGE-ME

# ---------- 4) Models per task — LATER (mock now) ----------
# One gateway assumption: a single base URL + key serving every model below.
# If yours differ per model, split into per-model _BASE/_KEY vars instead.
# How: paste the endpoint + key from your model provider, then flip AI_PROVIDER=real.
# AI_API_BASE=https://your-gateway.example.com/v1
# AI_API_KEY=sk-...

# Task → model mapping (verified against dev.meta.ai/docs/models + /models list, Nov 2026):
# All API model IDs are versioned — bare names (muse-spark, muse-image) 404.
# Muse Wonder (muse-wonder-1.0, preview) exists for long-horizon agent runs; the
# docs recommend Spark for classification + latency-sensitive work, so we stay put.
MODEL_CLASSIFY=muse-spark-1.3   # 25-label scoring, text-only, JSON-schema out. Fast path.
MODEL_VISION=muse-spark-1.3     # visual.metadata from screenshots (multimodal, parallel call).
MODEL_SEGMENT=sam-3.1            # layout masks; DOM-landmark fallback already captured (§10).
MODEL_RERANK=muse-spark-1.3     # search-time query rewrite + candidate re-rank (top 30 rows).
MODEL_THINK=muse-spark-1.3       # Think Space answers (grounded Q&A). Falls back to MODEL_CLASSIFY.
MODEL_THINK_QUICK=muse-spark-1.1  # Latency experiment: older point version for Quick mode.
MODEL_THINK_DEEP=muse-spark-1.3   # Deep mode stays on the flagship.
MODEL_EMBED=open-weights-local   # embeddings for similarity/search. Local open-weights
MODEL_EMBED_DIMS=1024            # recommended (also the $10K-bonus path). Set true dims here.
MODEL_IMAGE=muse-image-1.0             # memory-cluster contact sheets + style cards.
MODEL_TRANSCRIBE=muse-voice-transcribe-1.0  # hands-free queries from the side panel.
# MODEL_WONDER=muse-wonder-1.0   # preview; optional future Deep-mode upgrade ($4/$20 per 1M).
# SEARCH_API_KEY=   # Brave Search key → enables the Deep agent's web_search tool.
                    # Without it, Deep works from saves + fetched pages only.
MODEL_LOCAL=muse-spark-open      # optional offline pass (Glimmer also fine): local scoring
                                 # when network/AI is down; never blocks a save.

# ---------- 5) Optional, anytime ----------
# SENTRY_DSN=   # errors, web + extension
